{
  "name": "solana-ai",
  "version": "1.0.0",
  "description": "Solana AI and post-quantum cryptography research/prototype with reproducible ML-KEM/ML-DSA verification",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test:nist": "npx tsx tests/nist-pqc.test.mjs",
    "audit:crypto": "node scripts/audit-crypto.mjs",
    "reality:universal": "npx tsx scripts/reality-universal.ts",
    "reality:certify": "npx tsx scripts/generate-urs-certificate.ts",
    "test": "npm run test:nist && npm run audit:crypto && npm run reality:universal",
    "colosseum:setup": "node scripts/colosseum-copilot.mjs setup",
